{
  "name": "langonrock",
  "version": "0.2.1",
  "description": "Compiles OKF knowledge bundles into a dense, token-efficient manifest for AI agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "langonrock": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/client.ts"
  },
  "files": [
    "src",
    "native/*.c",
    "native/*.h",
    "native/README.md",
    "scripts/build-native.ts"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel",
    "build": "bun scripts/build.ts",
    "build:native": "bun scripts/build-native.ts",
    "check:dependencies": "bun scripts/check-runtime-dependencies.ts",
    "check:deadcode": "knip",
    "check:deps": "knip --include unlisted,unresolved,binaries",
    "bench:dbms": "bun bench/dbms/run.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@types/bun": "^1.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "knip": "6.34.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
